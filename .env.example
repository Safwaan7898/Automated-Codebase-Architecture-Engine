# ── ArchLens Root Environment Configuration ──────────────────────────────────
# Copy to .env and adjust values for your environment.

# Backend
ARCHLENS_ENV=development
ARCHLENS_HOST=0.0.0.0
ARCHLENS_PORT=8000
ARCHLENS_LOG_LEVEL=INFO
ARCHLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite public env vars — must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:8000
