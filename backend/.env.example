# Backend environment configuration
# Copy to .env and adjust values

ARCHLENS_ENV=development
ARCHLENS_HOST=0.0.0.0
ARCHLENS_PORT=8000
ARCHLENS_LOG_LEVEL=INFO
ARCHLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Engine Configuration (Optional, default OFF)
ARCHLENS_AI_ENABLED=false
# Provider chain order (comma-separated, e.g. groq,gemini,fake)
ARCHLENS_AI_PROVIDER_ORDER=groq,gemini
# Legacy fallback provider
ARCHLENS_AI_PROVIDER=fake
ARCHLENS_AI_API_KEY=
ARCHLENS_AI_MODEL=

# Per-provider API keys
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=

# Per-provider Model overrides (optional)
ARCHLENS_AI_MODEL_GROQ=openai/gpt-oss-20b
ARCHLENS_AI_MODEL_NVIDIA=google/diffusiongemma-26b-a4b-it
ARCHLENS_AI_MODEL_GEMINI=gemini-3.1-flash-lite

# Per-provider Requests-Per-Minute (RPM) limits
ARCHLENS_AI_RPM_GROQ=30
ARCHLENS_AI_RPM_NVIDIA=40
ARCHLENS_AI_RPM_GEMINI=15

# Privacy and budget controls
ARCHLENS_AI_ALLOW_TRAINING_PROVIDERS=false

# Cumulative total token limit (input + output) allowed across an entire codebase analysis
# (measured per analysis, NOT per individual API call)
ARCHLENS_AI_MAX_TOKENS_PER_ANALYSIS=10000

# Financial budget ceiling for an entire codebase analysis (measured in USD / US Dollars, e.g. 1.0 = $1.00)
ARCHLENS_AI_BUDGET=1.0

# Optional local Ollama configuration (OpenAI-compatible, no API key required)
# OLLAMA_BASE_URL=http://localhost:11434
# ARCHLENS_AI_MODEL_OLLAMA=llama3.2
# ARCHLENS_AI_RPM_OLLAMA=120

